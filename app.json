{
  "expo": {
    "name": "Prueba1-app",
    "slug": "Prueba1-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.edwinch.Prueba1app"
    },
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Se necesita la cámara para adjuntar fotografías de respaldo a las lecturas; es obligatoria para medidores dañados o consumos anómalos.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b4c7c07-cb77-406f-98fb-cec238131759"
      }
    }
  }
}
